# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID супергруппы, где бот ведёт запись (начинается с -100)
TELEGRAM_CHAT_ID=

# (опционально) путь к файлу данных, по умолчанию data.json
STORE_PATH=data.json

# (опционально) расписание создания игры, по умолчанию "0 20 * * *" (ежедневно в 20:00).
# Игра создаётся, если через 7 дней приходится игровой день.
CRON_SCHEDULE=

# (опционально) расписание очистки, по умолчанию "0 6 * * *" (ежедневно в 06:00).
# Переводит прошедшие игры в режим оплаты и удаляет старые.
CLEANUP_SCHEDULE=

# (опционально) таймзона, по умолчанию Europe/Moscow.
# В ней работает планировщик и считаются даты, независимо от зоны сервера.
TIMEZONE=

# (опционально) игровые дни через запятую (англ. названия, регистр не важен),
# по умолчанию: Tuesday,Thursday,Friday,Sunday
GAME_DAYS=Tuesday,Thursday,Saturday

# (опционально) через сколько дней после игры удалить её сообщение, по умолчанию 14
DELETE_AFTER_DAYS=
