# Все переменные, кроме первых двух, необязательны. Пустое значение означает значение по умолчанию.
# Некорректное значение останавливает бот при старте с сообщением, какая переменная неверна.

# ---------- Подключение ----------

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID супергруппы, где бот ведёт запись (начинается с -100)
TELEGRAM_CHAT_ID=

# Путь к файлу данных, по умолчанию data.json
STORE_PATH=data.json

# ---------- Расписание ----------
# Формат cron: минута час день месяц день_недели. Время считается в TIMEZONE.

# Таймзона, по умолчанию Europe/Moscow. В ней работает планировщик и считаются даты, независимо от зоны сервера.
TIMEZONE=

# Игровые дни через запятую (англ. названия, регистр не важен), по умолчанию Tuesday,Thursday,Friday,Sunday
GAME_DAYS=

# Время игры в сообщении, ЧЧ:ММ, по умолчанию 19:00
GAME_TIME=

# Создание игры, по умолчанию "0 20 * * *" (ежедневно в 20:00).
# Игра создаётся, если через CREATE_DAYS_AHEAD дней игровой день.
CRON_SCHEDULE=

# За сколько дней до игры создаётся её сообщение, по умолчанию 7
CREATE_DAYS_AHEAD=

# Через сколько после начала игры закрыть запись: кнопки записи сменяются кнопкой "Я оплатил зал", на доске игра
# переходит в "Прошедшие". Целое число минут в формате 60m, 1h30m, по умолчанию 1h. Проверка выполняется ежедневно
# в GAME_TIME + FINISH_AFTER и при старте бота.
FINISH_AFTER=

# Очистка, по умолчанию "10 0 * * *" (ежедневно в 00:10). Удаляет игры старше DELETE_AFTER_DAYS.
CLEANUP_SCHEDULE=

# Через сколько дней после игры удалить её сообщения, по умолчанию 7
DELETE_AFTER_DAYS=

# Проверка доски и её закрепа, по умолчанию "0 * * * *" (каждый час)
BOARD_CHECK_SCHEDULE=

# ---------- Запись ----------

# Сколько человек нужно на игру, по умолчанию 12
PLAYERS_LIMIT=

# Сколько друзей может привести один человек, по умолчанию 4
MAX_FRIENDS=

# Антиспам объявлений "состав собран" и "освободилось место": сколько времени после объявления бот редактирует его
# вместо отправки нового. Длительность в формате 90s, 10m, 1h, по умолчанию 10m
ANNOUNCE_COOLDOWN=

# ---------- Оплата зала ----------

# Сколько оформление оплаты одним человеком не даёт начать его другому. По истечении срока брошенное оформление
# может перехватить другой. Длительность, по умолчанию 1h
PAYMENT_DRAFT_LOCK=

# Максимум в ответе "сколько человек было", по умолчанию 30
PAYMENT_MAX_CAME=

# Допустимая сумма за зал в рублях, по умолчанию от 1000 до 10000
PAYMENT_MIN_TOTAL=
PAYMENT_MAX_TOTAL=

# Шаг округления доли вверх в рублях, по умолчанию 10
PAYMENT_ROUND_TO=
